              }
            }
          }
        }
      }
    },
    "/api/latex/compile": {
      "post": {
        "tags": [
          "research"
        ],
        "summary": "Compile Latex Endpoint",
        "description": "Compile LaTeX text to PDF and return the PDF file.\n\nCompilation is sandboxed \u2014 see `utils.latex` for what that covers.\n\nRequest Body:\n    latex_text: Raw LaTeX content to compile\n\nReturns:\n    PDF file\n\nStatus codes:\n    400: the document could not be compiled\n    503: no TeX toolchain is installed on this server",
        "operationId": "compile_latex_endpoint_api_latex_compile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LatexCompileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
