{
  "openapi": "3.1.0",
  "info": {
    "title": "Research Gap Discovery Engine API",
    "description": "API for extracting research parameters and discovering gaps",
    "version": "1.0.0"
  },
  "paths": {
    "/api/research": {
      "post": {
        "tags": [
          "research"
        ],
        "summary": "Research Endpoint",
        "description": "SSE endpoint for arXiv-based research extraction.\n\nRate limited hard: one call fans out to dozens of arXiv downloads and a\nlong chain of LLM requests.\n\nThis endpoint:\n1. Takes a user's research prompt (and optional topics) and generates topics via LLM when needed\n2. Searches arXiv for papers on each topic\n3. Downloads, extracts, and processes papers through the extraction pipeline\n4. Generates trend analysis and visualization data\n5. Streams progress updates via SSE\n\nThe final COMPLETED message includes a 'trends' key with all visualization data\nready for MUI X Charts in the React frontend.\n\nThe run executes as a background job, so losing this connection stops the\nstreaming, not the work. Every event carries a `job_id` and `sequence`;\nreconnect at GET /api/jobs/{job_id}/events?after={sequence} to pick up\nwhere it left off.",
        "operationId": "research_endpoint_api_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "research"
        ],
        "summary": "Get Job Endpoint",
        "description": "Current status of a research job.\n\nLets a client that lost its stream find out whether the run is still going\nbefore deciding to resume.",
        "operationId": "get_job_endpoint_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}/events": {
      "get": {
        "tags": [
          "research"
        ],
        "summary": "Stream Job Events Endpoint",
        "description": "Resume a job's SSE stream.\n\nArgs:\n    after: last sequence number already received. The default replays the\n        run from the beginning, so a client that missed everything still\n        gets the full picture.",
        "operationId": "stream_job_events_endpoint_api_jobs__job_id__events_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": -1,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/create_review": {
      "post": {
        "tags": [
          "research"
        ],
        "summary": "Create Review Endpoint",
        "description": "SSE endpoint for comprehensive literature review generation.\n\nThis endpoint streams real-time progress updates as it:\n1. Loads base papers from the saved processed dataset\n2. Searches arXiv for additional papers with diverse strategies (date, relevance, updates)\n3. Downloads and extracts text from PDFs with smart sectioning (first/last pages)\n4. Creates text chunks with priority weighting for key sections\n5. Selects most relevant chunks using weighted semantic similarity\n6. Generates LaTeX review using LLM\n7. Saves review and metadata\n\nRequest body:\n- saved_filepath: Path to the processed papers JSON file\n- paper_index: Index of the paper in the processed dataset\n- paper_info: Dictionary containing paper metadata (title, keywords, abstract, topic)\n\nThe final COMPLETED message includes:\n- LaTeX review content\n- Bibliography with all cited papers\n- Metadata about the review generation process\n- Statistics on papers and chunks processed",
        "operationId": "create_review_endpoint_api_create_review_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
