        "summary": "Get Graph Endpoint",
        "description": "Endpoint to retrieve the reference graph for a given project ID.\nReturns nodes and edges as stored in the graph (including authors).",
        "operationId": "get_graph_endpoint_api_graph__project_id___get",
        "parameters": [
