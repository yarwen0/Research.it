        "description": "Retrieve a specific review by ID.\n\nArgs:\n    review_id: Unique identifier for the review (timestamp)\n\nReturns:\n    Review data including LaTeX content and metadata",
        "operationId": "get_review_endpoint_api_reviews__review_id__get",
        "parameters": [
          {
            "name": "review_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Review Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "tags": [
          "research"
        ],
        "summary": "List Reviews Endpoint",
        "description": "List all reviews, optionally filtered by source dataset.\n\nQuery Parameters:\n    saved_filepath: Optional filter by source dataset filepath\n\nReturns:\n    List of review metadata dictionaries",
        "operationId": "list_reviews_endpoint_api_reviews_get",
