# Base URL of the Research.it backend API.
# Defaults to http://127.0.0.1:8000 when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public site URL, used to resolve Open Graph / social preview image URLs.
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=https://researchit.example.com
