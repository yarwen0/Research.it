# Root configuration for `docker compose up`.
# Copy to .env and fill in. For running the two projects natively instead,
# see be-main/.env.example and fe-main/.env.example.

# --- LLM provider ----------------------------------------------------------
# gemini | openrouter | ollama
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Used by the `local-llm` compose profile (no API key required).
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Database --------------------------------------------------------------
# Compose runs Postgres and wires DATABASE_URL for you. Running natively
# instead, the backend falls back to a local SQLite file with no setup.
# POSTGRES_USER=researchit
# POSTGRES_PASSWORD=researchit
# POSTGRES_DB=researchit

# --- Networking ------------------------------------------------------------
# Browser-visible backend URL, baked into the frontend at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins the backend accepts.
CORS_ORIGINS=http://localhost:3000

# Host ports to publish on.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# --- Build -----------------------------------------------------------------
# Set to false to skip TeX Live and shrink the backend image by ~700 MB.
# The LaTeX compile endpoint is then unavailable.
# INSTALL_LATEX=true
