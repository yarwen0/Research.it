# Google Gemini (recommended) — AI Studio API key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which provider to use: gemini | openrouter | ollama
# (unset = pick Gemini if GEMINI_API_KEY exists, else OpenRouter)
LLM_PROVIDER=gemini

# --- Ollama (local models; no API key, no rate limits) ---------------------
# Set LLM_PROVIDER=ollama to run entirely on your machine. Requires:
#   ollama serve            (usually auto-runs after install)
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: Gemini model id (defaults to gemini-2.5-flash-lite for higher free-tier quota)
# GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (optional). Chat uses OpenRouter only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Embeddings via OpenRouter (opt-in only). Leave unset/false so embeddings use Gemini
# when LLM_PROVIDER=gemini — avoids draining a separate embedding quota unintentionally.
# OPENROUTER_FOR_EMBEDDINGS=1
