# Google Gemini (recommended) — AI Studio API key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which provider to use: gemini | openrouter | ollama | vertex
# (unset = pick Gemini if GEMINI_API_KEY exists, else OpenRouter)
LLM_PROVIDER=gemini

# --- Ollama (local models; no API key, no rate limits) ---------------------
# Set LLM_PROVIDER=ollama to run entirely on your machine. Requires:
#   ollama serve            (usually auto-runs after install)
#   ollama pull qwen2.5:7b
#   ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window for local chat calls. Ollama's own default is 4096, which is
# too small for extraction prompts carrying paper text or a bibliography: the
# prompt gets silently truncated and generation slows badly. Lower it if the
# model does not fit in memory on your machine.
# OLLAMA_NUM_CTX=8192

# --- Vertex AI (Gemini on Google Cloud; no API key) -----------------------
# Set LLM_PROVIDER=vertex. Credentials come from Application Default
# Credentials: `gcloud auth application-default login` locally, the service
# account on Cloud Run. The project needs the Vertex AI API enabled.
# GOOGLE_CLOUD_PROJECT=your-project       # defaults to the ADC project
# GOOGLE_CLOUD_LOCATION=us-central1       # or "global"
# VERTEX_MODEL=gemini-2.5-flash-lite
# VERTEX_EMBED_MODEL=text-embedding-005

# Optional: Gemini model id (defaults to gemini-2.5-flash-lite for higher free-tier quota)
# GEMINI_MODEL=gemini-2.5-flash-lite

# OpenRouter (optional). Chat uses OpenRouter only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=

# Embeddings via OpenRouter (opt-in only). Leave unset/false so embeddings use Gemini
# when LLM_PROVIDER=gemini — avoids draining a separate embedding quota unintentionally.
# OPENROUTER_FOR_EMBEDDINGS=1

# --- Telemetry -------------------------------------------------------------
# Every LLM call is metered (tokens, latency, tokens/sec, estimated cost) and
# served per job at GET /api/jobs/{job_id}/metrics. That needs no setup.
#
# Trace export is separate and off by default. `console` prints spans as they
# finish; `otlp` sends them to any OTLP/HTTP collector (Jaeger, Tempo, ...).
# OTEL_TRACES_EXPORTER=console
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Cloud Trace, through Google's OTLP endpoint and default credentials:
# OTEL_TRACES_EXPORTER=gcp
# OTEL_SERVICE_NAME=researchit-api

# Cost estimates use list prices in telemetry/pricing.py. Override or extend
# them in USD per million tokens; unknown models report no cost, not zero.
# LLM_PRICES={"gemini-2.5-flash": {"input": 0.30, "output": 2.50}}

# Allowed browser origins for CORS, comma-separated. Defaults to "*" (any origin).
# Credentialed CORS is disabled while this is "*", since the wildcard would
# otherwise let any site issue credentialed calls. Set it in production:
# CORS_ORIGINS=https://researchit.example.com,https://www.researchit.example.com

# Host/port the API server binds to (defaults: 0.0.0.0 and 8000).
# HOST=0.0.0.0
# PORT=8000

# --- Rate limiting ---------------------------------------------------------
# Defaults shown. A research run costs dozens of PDF downloads and a long
# chain of LLM calls, so it is capped far below the general budget.
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_RESEARCH=5/hour
# RATE_LIMIT_REVIEW=10/hour
# RATE_LIMIT_COMPILE=30/minute
# RATE_LIMIT_ASK=60/hour
# RATE_LIMIT_ASSISTANT=20/hour

# In-memory counters are per-process and reset on restart. Point this at Redis
# once more than one worker serves traffic, or the effective limit multiplies
# by the worker count.
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# Set to 1 only when deployed behind a proxy that overwrites X-Forwarded-For
# (Fly.io, most load balancers). Without a proxy the header is spoofable, and
# trusting it lets any caller mint a fresh quota bucket per request.
# TRUST_PROXY_HEADERS=1

# Behind a proxy that appends to X-Forwarded-For instead of overwriting it —
# Google's front end on Cloud Run — set the number of such proxies. The caller
# is then read that many entries from the right; the left-most entry is
# whatever the client sent. Takes precedence over TRUST_PROXY_HEADERS.
# TRUSTED_PROXY_HOPS=1

# Set to 1 to turn rate limiting off entirely (local development only).
# RATE_LIMIT_DISABLED=1
