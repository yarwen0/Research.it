# syntax=docker/dockerfile:1
#
# Research.it backend — FastAPI + the arXiv/LLM pipeline.
#
# Build:  docker build -t researchit-backend be-main
# Run:    docker run -p 8000:8000 --env-file be-main/.env researchit-backend

# ---------------------------------------------------------------- builder ---
FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# build-essential is only needed to compile any sdist-only dependency; it is
# left behind in this stage so the runtime image stays slim.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r requirements.txt

# ---------------------------------------------------------------- runtime ---
FROM python:3.12-slim AS runtime

# A minimal TeX Live so POST /api/latex/compile works out of the box. Pass
# --build-arg INSTALL_LATEX=false for a ~700 MB smaller image; the endpoint
# then reports that LaTeX is unavailable instead of compiling.
ARG INSTALL_LATEX=true

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

# libmagic1 backs python-magic (PDF sniffing); curl backs the healthcheck.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmagic1 curl \
    && if [ "$INSTALL_LATEX" = "true" ]; then \
         apt-get install -y --no-install-recommends \
           texlive-latex-base \
           texlive-latex-recommended \
           texlive-fonts-recommended \
           texlive-bibtex-extra ; \
       fi \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

RUN useradd --create-home --uid 10001 appuser
COPY --chown=appuser:appuser . .
RUN mkdir -p data && chown appuser:appuser data
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
